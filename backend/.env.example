# PEHCHAAN API Environment Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg2://pehchaan:pehchaan@localhost:5432/pehchaan_db

# JWT Secret Key — CHANGE THIS IN PRODUCTION
SECRET_KEY=dev-only-secret-key-change-in-production

# JWT Token Expiry (minutes) — 480 = 8 hour shift
ACCESS_TOKEN_EXPIRE_MINUTES=480
