# PEHCHAAN API Environment Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg2://pehchaan:pehchaan@localhost:5432/pehchaan_db

# JWT Secret Key — CHANGE THIS IN PRODUCTION
SECRET_KEY=dev-only-secret-key-change-in-production

# JWT Token Expiry (minutes) — 480 = 8 hour shift
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Polygon Blockchain Integrity Layer (Polygon Amoy Testnet - Chain ID 80002)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
POLYGON_CONTRACT_ADDRESS=0x789A842d0F37a9163f350c370A101C5B529Ae913
POLYGON_PRIVATE_KEY=
POLYGON_NETWORK=polygon-amoy
POLYGON_EXPLORER_URL=https://amoy.polygonscan.com
