# PEHCHAAN Expo Frontend Environment Configuration

# OPTION 1: Tunnel Mode (RECOMMENDED for mobile hotspot / tethering where direct LAN is blocked)
# Cloudflare Tunnel / LocalTunnel HTTPS URL:
# EXPO_PUBLIC_API_URL=https://inter-gourmet-deutsche-ride.trycloudflare.com

# OPTION 2: Direct LAN IPv4 (For standard Wi-Fi router / local network)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8001

# OPTION 3: Auto-detection (Leave blank to let Expo automatically resolve the Metro host IP on port 8001)
# EXPO_PUBLIC_API_URL=
